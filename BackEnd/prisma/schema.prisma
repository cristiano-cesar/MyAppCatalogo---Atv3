
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Produto {
  id            Int      @id @default(autoincrement())
  nome          String   @unique
  descricao     String   @db.Text
  preco         Decimal  @db.Decimal(10, 2)
  imagemUrl     String?  @map("imageUrl")
  criacaoAt     DateTime @default(now())
  atualizacaoAt DateTime @updatedAt

  @@map("produtos")
}


model User {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senha     String
  criadoEm  DateTime @default(now())

  @@map("users")
}
